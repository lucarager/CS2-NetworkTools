<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<Title>NetworkTools</Title>
		<AssemblyTitle>$(Title)</AssemblyTitle>
		<Description>A Cities: Skylines 2 mod.</Description>
		<Authors>Luca Rager</Authors>
		<Product>$(Title)</Product>
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
		<Version>1.5.4</Version>
		<AssemblyVersion>$(Version).0</AssemblyVersion>
		<FileVersion>$(Version).0</FileVersion>
	</PropertyGroup>

	<!-- Don't compile the submodule's own build output -->
	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);Common\obj\**;Common\bin\**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- Shared build config: package refs, LangVersion, configs (Debug;Release;I18N), DefineConstants, <Reference> list -->
	<Import Project="Common\LucaModsCommon.props" />

	<!-- CSII toolchain -->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<!-- Shared build steps (BuildUI / CopyIcons / CustomModPostProcessorConfig / GeneratePublishConfiguration).
	     MUST be imported AFTER Mod.targets so the shared CustomModPostProcessorConfig overrides the stub. -->
	<Import Project="Common\LucaModsCommon.targets" />

	<!-- Re-assert language/unsafe settings AFTER the CSII toolchain imports, which reset LangVersion
	     (LucaModsCommon.props sets these too, but Mod.props/Mod.targets override them; NetworkTools
	     uses C# 11 'required' members so this must win). -->
	<PropertyGroup>
		<LangVersion>11.0</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="UI\node_modules\**" />
		<EmbeddedResource Remove="UI\node_modules\**" />
		<None Remove="UI\node_modules\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
		<None Include=".agents\instructions.md" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="L10n\lang\" />
		<Content Include="L10n\lang\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<EmbeddedResource Include="L10n\lang\*.json" Exclude="L10n\lang\en-US.json" />
	</ItemGroup>

	<!--Generate TypeScript parameter definitions from C# source (NT-specific; runs before the shared BuildUI)-->
	<Target Name="GenerateParametersTS" BeforeTargets="BuildUI">
		<Message Text="[GenerateParametersTS]" Importance="high" />
		<Exec Command="dotnet run --project &quot;$(SolutionDir)NetworkTools.Codegen&quot; -- &quot;$(ProjectDir)Systems&quot; &quot;$(ProjectDir)UI/src/generated/parameters.generated.ts&quot; --configuration $(Configuration)" />
	</Target>

</Project>
